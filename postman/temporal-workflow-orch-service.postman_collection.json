    {
      "name": "Feedback: remind me later (2d, WhatsApp)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/workflows/{{definition}}-{{voiceCustomerId}}/feedback",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "workflows",
            "{{definition}}-{{voiceCustomerId}}",
            "feedback"
          ]
        },
        "description": "Customer asks to be reminded in 2 days on WhatsApp. Send after the Day 1 contact.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"REMIND_LATER\",\n  \"remindAfter\": \"2d\",\n  \"channel\": \"WHATSAPP\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 202\", function () { pm.response.to.have.status(202); });",
              "pm.test(\"normalised\", function () { pm.expect(pm.response.json().type).to.eql(\"REMIND_LATER\"); });"
            ]
          }
        }
      ]
    },
