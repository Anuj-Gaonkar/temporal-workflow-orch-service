    {
      "name": "Start workflow, duplicate (expects 409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/workflows/start",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "workflows",
            "start"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{voiceCustomerId}}\",\n  \"definition\": \"{{definition}}\"\n}"
        },
        "description": "Needs the VOICE workflow from the request above to still be running (true for 30 minutes with the shipped YAML). Expects 409."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 409\", function () { pm.response.to.have.status(409); });"
            ]
          }
        }
      ]
    },
