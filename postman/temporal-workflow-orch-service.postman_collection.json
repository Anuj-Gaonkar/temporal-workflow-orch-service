    },
    {
      "name": "Start workflow, VOICE customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/workflows/start",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "workflows",
            "start"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{voiceCustomerId}}\",\n  \"definition\": \"{{definition}}\"\n}"
        },
        "description": "Starts OUTREACH_DEFAULT for a VOICE customer: call now, message after the delay. Run this before the duplicate request."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 202\", function () { pm.response.to.have.status(202); });",
              "pm.test(\"workflow id scheme\", function () { pm.expect(pm.response.json().workflowId).to.eql(pm.collectionVariables.get(\"definition\") + \"-\" + pm.collectionVariables.get(\"voiceCustomerId\")); });\npm.collectionVariables.set(\"voiceWorkflowId\", pm.response.json().workflowId);"
            ]
          }
        }
      ]
    },
