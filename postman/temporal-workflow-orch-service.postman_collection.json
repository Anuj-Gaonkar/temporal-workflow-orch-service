{
  "info": {
    "name": "temporal-workflow-orch-service",
    "description": "Phase 2. Run top to bottom against the running app (see README). Feedback requests must be sent after the contact they answer (Day 1 10:00 IST, or after the shortened demo day). The duplicate/409 request needs the VOICE workflow still running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "List definitions",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/workflow-definitions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "workflow-definitions"
          ]
        },
        "description": "Lists the loaded YAML definitions (name, description, step ids)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"OUTREACH_DEFAULT is loaded\", function () { pm.expect(pm.response.json().map(d => d.name)).to.include(pm.collectionVariables.get(\"definition\")); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Get customer (VOICE customer)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/customers/{{voiceCustomerId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "customers",
            "{{voiceCustomerId}}"
          ]
        },
        "description": "Read-only view of a VOICE customer row."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"channel is VOICE\", function () { pm.expect(pm.response.json().initialChannel).to.eql(\"VOICE\"); });"
            ]
          }
        }
      ]
    },
